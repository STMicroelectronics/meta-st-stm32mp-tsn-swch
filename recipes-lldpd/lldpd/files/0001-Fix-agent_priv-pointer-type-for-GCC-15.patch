Upstream-Status: Inappropriate [embedded specific]

Fix incompatible pointer type errors with GCC 15.2 strict type checking.
The netsnmp_transport function pointers f_send, f_fmtaddr, and
f_create_from_ostring expect const void * as their data parameter.

diff --git a/src/daemon/agent_priv.c b/src/daemon/agent_priv.c
index 1111111..2222222 100644
--- a/src/daemon/agent_priv.c
+++ b/src/daemon/agent_priv.c
@@ -37,7 +37,7 @@
 static netsnmp_tdomain unixDomain;
 
 static char *
-agent_priv_unix_fmtaddr(netsnmp_transport *t, void *data, int len)
+agent_priv_unix_fmtaddr(netsnmp_transport *t, const void *data, int len)
 {
 	/* We don't bother to implement the full function */
 	return strdup("Local Unix socket with privilege separation: unknown");
@@ -80,7 +80,7 @@ agent_priv_unix_recv(netsnmp_transport *t, void *buf, int size,
 
 #define AGENT_WRITE_TIMEOUT 2000
 static int
-agent_priv_unix_send(netsnmp_transport *t, void *buf, int size,
+agent_priv_unix_send(netsnmp_transport *t, const void *buf, int size,
     void **opaque, int *olength)
 {
 	int rc = -1;
@@ -217,7 +217,7 @@ agent_priv_unix_recv(netsnmp_transport *t, void *buf, int size,
 }
 
 static netsnmp_transport *
-agent_priv_unix_create_ostring(const u_char * o, size_t o_len, int local)
+agent_priv_unix_create_ostring(const void * o, size_t o_len, int local)
 {
 	return agent_priv_unix_transport((char *)o, o_len, local);
 }
