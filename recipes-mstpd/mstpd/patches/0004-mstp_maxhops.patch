From: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Date: Wed, 13 May 2026 13:54:16 +0200
Subject: [PATCH 4/6] mstp_maxhops

---
 mstp.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/mstp.c b/mstp.c
index da4da08..db9b62f 100644
--- a/mstp.c
+++ b/mstp.c
@@ -834,9 +834,9 @@ int MSTP_IN_set_cist_bridge_config(bridge_t *br, CIST_BridgeConfig *cfg)
 
     if(cfg->set_max_hops)
     {
-        if((6 > cfg->max_hops) || (100 < cfg->max_hops))
+        if((6 > cfg->max_hops) || (255 < cfg->max_hops))
         {
-            ERROR_BRNAME(br, "Bridge Max Hops must be between 6 and 100");
+            ERROR_BRNAME(br, "Bridge Max Hops must be between 6 and 255");
             r = -1;
         }
     }
